[Unit]
Description=wpscatcher autoinstall fase 2
After=network-online.target
Wants=network-online.target
ConditionPathExists=/opt/wpscatcher-src/stage2.sh

[Service]
Type=oneshot
ExecStart=/bin/bash /opt/wpscatcher-src/stage2.sh
RemainAfterExit=no
TimeoutStartSec=1800
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
