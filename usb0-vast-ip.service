[Unit]
Description=Vast adres op usb0 (gadget-terugval)
# Bewust los van NetworkManager: die wordt door install.sh gemaskeerd, en
# juist dan moet deze weg naar binnen blijven werken. Niet aan de device-unit
# hangen -- die bestaat niet betrouwbaar zonder aangesloten host.
After=multi-user.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/bash -c "for i in $(seq 1 20); do [ -d /sys/class/net/usb0 ] && break; sleep 1; done; ip addr replace 10.55.0.1/24 dev usb0 && ip link set usb0 up"

[Install]
WantedBy=multi-user.target
